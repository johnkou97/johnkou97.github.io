<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work_groups = data[1] | group_by: 'name' %}

  {% for group in work_groups %}
    {% assign company = group.items.first %}

    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <h5 class="title font-weight-bold" style="margin: 0;">
              {% if company.url %}
                <a href="{{ company.url }}" target="_blank" style="text-decoration: none; color: inherit;">{{ group.name }}</a>
              {% else %}
                {{ group.name }}
              {% endif %}
            </h5>

            {% if company.location %}
              <p class="location" style="margin: 0;">
                <i class="fa-solid fa-location-dot iconlocation"></i>
                {{ company.location }}
              </p>
            {% endif %}
          </div>
        </div>
      </div>

      {% for role in group.items %}
        <div class="row">
          <div class="col-xs-2 col-sm-2 col-md-2 text-center" style="padding-right: 15px;">
            {% if role.startDate %}
              {% assign startDate = role.startDate | split: '-' | slice: 0, 2 | join: '.' %}
              {% assign endDate = role.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
              {% assign date = startDate | append: ' - ' | append: endDate %}
            {% else %}
              {% assign date = '' %}
            {% endif %}

            <span
              class="badge font-weight-bold danger-color-dark text-uppercase align-middle"
              style="min-width: 75px; font-size: 0.65rem; margin-top: 5px; white-space: normal;"
            >
              {{ date }}
            </span>
          </div>

          <div class="col-xs-10 col-sm-10 col-md-10" style="border-left: 2px solid #e0e0e0; padding-left: 20px; padding-bottom: 20px;">
            <h6 class="title font-weight-bold" style="margin-top: 0; margin-bottom: 5px;">
              {{ role.position }}
            </h6>

            {% if role.summary %}
              <div class="text-muted" style="font-size: 0.95rem; font-style: italic; margin-bottom: 10px;">
                {{ role.summary }}
              </div>
            {% endif %}

            {% if role.highlights %}
              <ul class="items" style="padding-left: 20px; margin-bottom: 0;">
                {% for item in role.highlights %}
                  <li>
                    <span class="item">{{ item }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </li>
  {% endfor %}
</ul>
