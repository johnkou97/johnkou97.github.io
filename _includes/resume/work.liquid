<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work_groups = data[1] | group_by: "name" %}
  
  {% for group in work_groups %}
    {% assign company = group.items.first %}
    
    <li class="list-group-item">
      <div class="row">
        
        <div class="col-md-12">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="title font-weight-bold mb-0">
              {% if company.url %}
                <a href="{{ company.url }}" target="_blank" class="text-dark" style="text-decoration: none;">{{ group.name }}</a>
              {% else %}
                {{ group.name }}
              {% endif %}
            </h5>

            {% if company.location %}
              <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle">
                <i class="fa-solid fa-location-dot iconlocation mr-1"></i>
                {{ company.location }}
              </span>
            {% endif %}
          </div>
        </div>

        <div class="col-md-12 mt-2">
          <div style="border-left: 2px solid #e0e0e0; margin-left: 10px; padding-left: 20px;">
            {% for role in group.items %}
              <div class="mb-4">
                
                <div class="d-flex justify-content-between align-items-baseline flex-wrap">
                  <h6 class="font-weight-bold text-dark mb-1">{{ role.position }}</h6>
                  
                  <span style="font-size: 0.85rem; font-style: italic; color: #666;">
                    {{ role.startDate }} 
                    {% if role.endDate != '' %}
                      - {{ role.endDate }}
                    {% else %}
                      - Present
                    {% endif %}
                  </span>
                </div>

                {% if role.summary %}
                  <div class="text-muted mt-1" style="font-size: 0.95rem;">{{ role.summary }}</div>
                {% endif %}

                {% if role.highlights and role.highlights.size > 0 %}
                  <ul class="items mt-2">
                    {% for item in role.highlights %}
                      <li><span class="item">{{ item }}</span></li>
                    {% endfor %}
                  </ul>
                {% endif %}
                
              </div>
            {% endfor %}
          </div>
        </div>

      </div>
    </li>
  {% endfor %}
</ul>